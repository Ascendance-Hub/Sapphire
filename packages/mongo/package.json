{
  "name": "@ascendance-hub/sapphire-mongo",
  "version": "0.5.0",
  "description": "Adapter Mongoose para o Sapphire.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@ascendance-hub/sapphire-core": "*",
    "mongoose": "^9 || ^10"
  },
  "devDependencies": {
    "@ascendance-hub/sapphire-core": "*",
    "mongoose": "^9.6.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ascendance-Hub/Sapphire.git",
    "directory": "packages/mongo"
  },
  "keywords": [
    "typescript",
    "schema",
    "mongoose",
    "mongodb",
    "sapphire"
  ],
  "author": {
    "name": "Alexandre Damas Murata",
