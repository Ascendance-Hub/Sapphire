{
  "name": "@ascendance-hub/sapphire-core",
  "version": "1.2.0",
  "description": "Core do Sapphire — fields, IR, registry de adapters e geração de tipos.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ascendance-Hub/Sapphire.git",
    "directory": "packages/core"
  },
  "keywords": [
    "typescript",
    "schema",
    "validation",
    "orm"
  ],
  "author": {
    "name": "Alexandre Damas Murata",
    "email": "alexandre_murata@hotmail.com"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "bugs": {
    "url": "https://github.com/Ascendance-Hub/Sapphire/issues"
  },
  "homepage": "https://github.com/Ascendance-Hub/Sapphire#readme"
}
