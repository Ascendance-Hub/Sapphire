{
  "name": "@ascendance-hub/sapphire-drizzle",
  "version": "1.0.0",
  "description": "Drizzle adapter for Sapphire (pg/mysql/sqlite).",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@ascendance-hub/sapphire-core": ">=1.0.0",
    "drizzle-orm": "^0.44 || ^0.45"
  },
  "devDependencies": {
    "@ascendance-hub/sapphire-core": "*",
    "@electric-sql/pglite": "^0.4.0",
    "better-sqlite3": "^12.0.0",
    "drizzle-kit": "^0.31.0",
    "drizzle-orm": "^0.45.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ascendance-Hub/Sapphire.git",
    "directory": "packages/drizzle"
  },
  "keywords": [
    "typescript",
    "schema",
    "drizzle",
    "drizzle-orm",
    "sapphire"
  ],
  "author": {
    "name": "Alexandre Damas Murata",
    "email": "alexandre_murata@hotmail.com"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "bugs": {
    "url": "https://github.com/Ascendance-Hub/Sapphire/issues"
  },
  "homepage": "https://github.com/Ascendance-Hub/Sapphire#readme"
}
