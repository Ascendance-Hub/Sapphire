{
  "name": "@ascendance-hub/sapphire-bson",
  "version": "1.0.0",
  "description": "Native MongoDB driver adapter for Sapphire — emits $jsonSchema collection validators.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@ascendance-hub/sapphire-core": ">=1.0.0",
    "mongodb": "^6 || ^7"
  },
  "peerDependenciesMeta": {
    "mongodb": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ascendance-hub/sapphire-core": "*",
    "mongodb": "^7.2.0",
    "mongodb-memory-server": "^11.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ascendance-Hub/Sapphire.git",
    "directory": "packages/bson"
  },
  "keywords": [
    "typescript",
    "schema",
    "bson",
    "mongodb",
    "jsonschema",
    "validator",
    "sapphire"
  ],
  "author": {
    "name": "Alexandre Damas Murata",
    "email": "alexandre_murata@hotmail.com"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "bugs": {
    "url": "https://github.com/Ascendance-Hub/Sapphire/issues"
  },
  "homepage": "https://github.com/Ascendance-Hub/Sapphire#readme"
}
