---
import { useTranslations, asLocale } from '../i18n/ui'
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const locale = asLocale(Astro.currentLocale)
const t = useTranslations(locale)
const prefix = locale === 'pt-br' ? `${base}/pt-br` : base

// The current path with the locale prefix stripped — used to build the
// equivalent URL in the other locale.
const path = Astro.url.pathname.replace(/\/$/, '')
const bare = path.startsWith(`${base}/pt-br`)
  ? path.slice(`${base}/pt-br`.length)
  : path.slice(base.length)
const enHref = `${base}${bare || '/'}`
const ptHref = `${base}/pt-br${bare || '/'}`
---
<nav class="nav">
  <a class="logo" href={`${prefix}/`}>◆ Sapph<span>ire</span></a>
  <div class="links">
    <a href={`${prefix}/docs`}>{t('nav.docs')}</a>
    <a href={`${prefix}/playground`}>{t('nav.playground')}</a>
    <a class="gh" href="https://github.com/Ascendance-Hub/Sapphire">{t('nav.github')}</a>
    <span class="flags">
      <a
        class:list={['flag', { on: locale === 'en' }]}
        href={enHref}
        data-locale="en"
        aria-label="English">🇺🇸</a
      >
      <a
        class:list={['flag', { on: locale === 'pt-br' }]}
        href={ptHref}
        data-locale="pt-br"
        aria-label="Português">🇧🇷</a
      >
    </span>
  </div>
</nav>

<script>
  // Remember the chosen locale and apply it on later visits.
  const KEY = 'sapphire-locale'
  document.querySelectorAll('.flag').forEach((el) => {
    el.addEventListener('click', () => {
      localStorage.setItem(KEY, (el as HTMLElement).dataset.locale ?? 'en')
    })
  })
  const saved = localStorage.getItem(KEY)
  if (saved) {
    const path = location.pathname.replace(/\/$/, '')
    const isPt = /\/pt-br(\/|$)/.test(path)
    if (saved === 'pt-br' && !isPt) {
      const flag = document.querySelector('.flag[data-locale="pt-br"]') as HTMLAnchorElement | null
      if (flag) location.replace(flag.href)
    } else if (saved === 'en' && isPt) {
      const flag = document.querySelector('.flag[data-locale="en"]') as HTMLAnchorElement | null
      if (flag) location.replace(flag.href)
    }
  }
</script>

<style>
  .nav {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 13px 22px;
    border-bottom: 1px solid var(--border);
    background: var(--bg);
  }
  .logo { font-weight: 800; color: var(--ink-900); font-size: 16px; }
  .logo:hover { text-decoration: none; }
  .logo span { color: var(--sapphire-600); }
  .links { margin-left: auto; display: flex; gap: 18px; align-items: center; font-size: 14px; }
  .links a { color: var(--ink-600); }
  .gh { background: var(--ink-900); color: #fff !important; padding: 6px 13px; border-radius: 6px; }
  .gh:hover { text-decoration: none; }
  .flags { display: flex; gap: 6px; }
  .flag { font-size: 16px; opacity: 0.4; filter: grayscale(1); }
  .flag:hover { text-decoration: none; opacity: 0.85; }
  .flag.on { opacity: 1; filter: none; }

  /* Phones: tighten spacing; wrap to a second row rather than overflow. */
  @media (max-width: 560px) {
    .nav { gap: 10px; padding: 11px 14px; flex-wrap: wrap; }
    .links { gap: 13px; font-size: 13px; }
    .gh { padding: 5px 10px; }
  }
</style>
