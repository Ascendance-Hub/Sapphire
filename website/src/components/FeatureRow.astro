---
import { useTranslations, asLocale } from '../i18n/ui'
const t = useTranslations(asLocale(Astro.currentLocale))
const features = [
  { icon: '⛃', title: t('features.multiOutput.title'), body: t('features.multiOutput.body') },
  { icon: '{ }', title: t('features.typed.title'), body: t('features.typed.body') },
  { icon: '✓', title: t('features.validation.title'), body: t('features.validation.body') },
]
---
<section class="features">
  {features.map((f) => (
    <article class="feature">
      <div class="icon">{f.icon}</div>
      <h3>{f.title}</h3>
      <p>{f.body}</p>
    </article>
  ))}
</section>

<style>
  .features {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
    max-width: var(--maxw);
    margin: 48px auto 0;
    padding: 0 22px;
  }
  .feature { flex: 1 1 240px; }
  .icon {
    width: 38px;
    height: 38px;
    border-radius: 9px;
    background: #e9f1fb;
    color: var(--sapphire-600);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    margin-bottom: 10px;
  }
  .feature h3 { margin: 0 0 4px; font-size: 16px; }
  .feature p { margin: 0; color: var(--ink-600); font-size: 14px; }
</style>
